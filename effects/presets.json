  "voice_fx": {
    "_doc": "Voice effects (like ElevenLabs' Filter / Noise / Space / Distance). Stages: hp/lp/peak/lowshelf/highshelf (RBJ biquads, q = quality, g = dB), drive (tanh k), crush (bits), ring (f Hz, mix), gain (db). Mirrored in app/render/voicefx.py and web/js/voicefx.js. Noise beds come from library/ambience/.",
    "filters": [
      {"id": "phone", "name": "Phone call", "desc": "Narrow telephone line",
       "stages": [{"t": "hp", "f": 320, "q": 0.9}, {"t": "hp", "f": 320, "q": 0.6}, {"t": "lp", "f": 3300, "q": 0.9}, {"t": "lp", "f": 3300, "q": 0.6}, {"t": "peak", "f": 1700, "q": 1.0, "g": 5}, {"t": "drive", "k": 2.2}, {"t": "gain", "db": -2}]},
      {"id": "old_radio", "name": "Old radio", "desc": "Boxy AM radio",
       "stages": [{"t": "hp", "f": 450, "q": 0.8}, {"t": "hp", "f": 450, "q": 0.6}, {"t": "lp", "f": 3800, "q": 0.8}, {"t": "lp", "f": 3800, "q": 0.6}, {"t": "peak", "f": 1400, "q": 0.8, "g": 6}, {"t": "drive", "k": 3.5}, {"t": "crush", "bits": 11}, {"t": "gain", "db": -4}]},
      {"id": "walkie", "name": "Walkie-talkie", "desc": "Crunchy two-way radio",
       "stages": [{"t": "hp", "f": 650, "q": 1.0}, {"t": "hp", "f": 650, "q": 0.6}, {"t": "lp", "f": 2700, "q": 1.0}, {"t": "lp", "f": 2700, "q": 0.6}, {"t": "peak", "f": 1900, "q": 1.2, "g": 6}, {"t": "drive", "k": 7}, {"t": "crush", "bits": 8}, {"t": "gain", "db": -7}]},
      {"id": "megaphone", "name": "Megaphone", "desc": "Loud, honky horn speaker",
       "stages": [{"t": "hp", "f": 700, "q": 1.1}, {"t": "hp", "f": 700, "q": 0.6}, {"t": "lp", "f": 4300, "q": 0.9}, {"t": "lp", "f": 4300, "q": 0.6}, {"t": "peak", "f": 2400, "q": 1.4, "g": 8}, {"t": "drive", "k": 9}, {"t": "gain", "db": -8}]},
      {"id": "lofi", "name": "Lo-fi", "desc": "Dull, crushed and warm",
       "stages": [{"t": "hp", "f": 120, "q": 0.7}, {"t": "lp", "f": 3600, "q": 0.7}, {"t": "crush", "bits": 7}, {"t": "drive", "k": 1.6}, {"t": "gain", "db": -2}]},
      {"id": "tv_speaker", "name": "TV speaker", "desc": "Small built-in speaker",
       "stages": [{"t": "hp", "f": 260, "q": 0.8}, {"t": "lp", "f": 6500, "q": 0.7}, {"t": "peak", "f": 3000, "q": 1.0, "g": 3}]},
      {"id": "vintage_mic", "name": "Vintage mic", "desc": "Warm, darker microphone",
       "stages": [{"t": "hp", "f": 90, "q": 0.7}, {"t": "lowshelf", "f": 220, "g": 2.5}, {"t": "highshelf", "f": 5000, "g": -6}, {"t": "drive", "k": 1.3}]},
      {"id": "through_wall", "name": "Through a wall", "desc": "Muffled, from the next room",
       "stages": [{"t": "hp", "f": 80, "q": 0.7}, {"t": "lp", "f": 620, "q": 0.8}, {"t": "lowshelf", "f": 200, "g": 3}, {"t": "gain", "db": -5}]},
      {"id": "underwater", "name": "Underwater", "desc": "Deep and wobbly-dark",
       "stages": [{"t": "lp", "f": 420, "q": 1.4}, {"t": "lowshelf", "f": 150, "g": 4}, {"t": "gain", "db": -3}]},
      {"id": "robot", "name": "Robot", "desc": "Metallic ring-modulated voice",
       "stages": [{"t": "hp", "f": 180, "q": 0.7}, {"t": "ring", "f": 58, "mix": 0.75}, {"t": "peak", "f": 1300, "q": 1.2, "g": 4}, {"t": "gain", "db": 1}]}
    ],
    "spaces": [
